# Vignan AI Campus EventOps - Backend Configuration

# Application
PROJECT_NAME="Vignan AI Campus EventOps"
VERSION="1.0.0"
DEBUG=True
API_V1_STR="/api"

# Server
HOST="0.0.0.0"
PORT=8000

# CORS (Comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# MongoDB Database Configuration
# Provide your MongoDB Atlas Connection String or local MongoDB URI
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="vignan_eventops"

# Authentication & Security (JWT)
JWT_SECRET="vignan_secret_key_change_in_production_jwt_hackathon_2026_super_secure"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Anthropic Claude)
# Place your Anthropic API Key here - NEVER expose to frontend
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
